// Schéma Prisma : https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Authentification (généré par `npx auth generate`) ───────────────────────

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  exercises Exercise[]
  programs  Program[]
  workouts  Workout[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Catalogue d'exercices ───────────────────────────────────────────────────

enum TrackingType {
  WEIGHTED // suivi en charge (barre, haltères, machines)
  BODYWEIGHT // suivi en reps et en variante de progression
  BOTH // poids du corps lesté : reps, variante et lest facultatif
}

enum MuscleRole {
  PRIMARY
  SECONDARY
}

// Commun à tous les utilisateurs, rempli par le seed
model MuscleGroup {
  id        String                @id @default(cuid())
  name      String                @unique
  exercises ExerciseMuscleGroup[]

  @@map("muscle_group")
}

model Exercise {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  trackingType TrackingType
  // Reps comptées par bras / jambe (ex. rowing haltère, pistol squat)
  isUnilateral Boolean      @default(false)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  muscles          ExerciseMuscleGroup[]
  variants         ExerciseVariant[]
  programExercises ProgramExercise[]
  sets             SetLog[]

  @@unique([userId, name])
  @@map("exercise")
}

model ExerciseMuscleGroup {
  exerciseId    String
  exercise      Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscleGroupId String
  muscleGroup   MuscleGroup @relation(fields: [muscleGroupId], references: [id], onDelete: Restrict)
  role          MuscleRole

  @@id([exerciseId, muscleGroupId])
  @@map("exercise_muscle_group")
}

// Variantes de progression d'un exercice au poids du corps,
// ex. pistol squat assisté (1), sur box (2), complet (3)
model ExerciseVariant {
  id         String   @id @default(cuid())
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  name       String
  level      Int
  sets       SetLog[]

  @@unique([exerciseId, level])
  @@unique([exerciseId, name])
  @@map("exercise_variant")
}

// ─── Programme (le prévu) ────────────────────────────────────────────────────

// Un seul programme actif par utilisateur, garanti côté application
model Program {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  isActive        Boolean      @default(false)
  sessionsPerWeek Int          @default(4)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  days            ProgramDay[]

  @@index([userId])
  @@map("program")
}

// Rotation : les places `rotationSlot` s'enchaînent dans l'ordre (1 Pull, 2 Push, 1 Pull…).
// Plusieurs jours peuvent partager une place (Pull court / Pull complet) et sont alors interchangeables.
// Seuls les jours en rotation comptent dans `sessionsPerWeek` ; les autres (jambes maison) sont des bonus.
model ProgramDay {
  id           String            @id @default(cuid())
  programId    String
  program      Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  name         String
  // Ordre d'affichage
  position     Int
  // null = hors rotation (bonus)
  rotationSlot Int?
  exercises    ProgramExercise[]
  workouts     Workout[]

  @@unique([programId, position])
  @@map("program_day")
}

model ProgramExercise {
  id            String     @id @default(cuid())
  programDayId  String
  programDay    ProgramDay @relation(fields: [programDayId], references: [id], onDelete: Cascade)
  exerciseId    String
  exercise      Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  position      Int
  targetSets    Int
  // Les deux à null = max reps propres
  repMin        Int?
  repMax        Int?
  // Repos par défaut du chronomètre, modifiable en séance
  restSeconds   Int?
  // Exercices du même jour avec le même numéro enchaînés en superset ;
  // le repos est celui du dernier exercice du superset
  supersetGroup Int?
  // Consignes propres à cette séance (tempo, seuil pour ajouter du lest…)
  notes         String?
  sets          SetLog[]

  @@unique([programDayId, position])
  @@map("program_exercise")
}

// ─── Séances (le réalisé) ────────────────────────────────────────────────────

model Workout {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Conservée à null si le jour est supprimé du programme, pour garder l'historique
  programDayId String?
  programDay   ProgramDay? @relation(fields: [programDayId], references: [id], onDelete: SetNull)
  startedAt    DateTime    @default(now())
  finishedAt   DateTime?
  notes        String?
  sets         SetLog[]

  @@index([userId, startedAt])
  @@map("workout")
}

model SetLog {
  id                String           @id @default(cuid())
  workoutId         String
  workout           Workout          @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId        String
  exercise          Exercise         @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  // Bloc du programme d'origine : distingue un même exercice fait deux fois
  // dans une séance (dips lestés puis dips volume) ; null si le bloc est supprimé
  programExerciseId String?
  programExercise   ProgramExercise? @relation(fields: [programExerciseId], references: [id], onDelete: SetNull)
  setNumber         Int
  reps              Int
  // Charge en kg (WEIGHTED) ou lest (BOTH) ; null si aucune charge
  weightKg          Float?
  variantId         String?
  variant           ExerciseVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())

  @@unique([workoutId, programExerciseId, setNumber])
  @@index([exerciseId])
  @@map("set_log")
}
